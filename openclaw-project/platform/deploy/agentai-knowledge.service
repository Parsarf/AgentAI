[Unit]
Description=Lumina knowledge index: read customers' files into passages, finish removals
After=network-online.target agentai-platform-app.service agentai-render.service

[Service]
Type=simple
User=agentai-platform
Group=agentai-platform
WorkingDirectory=/opt/agentai-platform/current
EnvironmentFile=/etc/agentai-platform/accounts.env
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/agentai-platform/current/.venv/bin/python manage.py knowledge_worker --serve
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/agentai-platform
ReadOnlyPaths=/etc/agentai-platform
# The parsing itself happens in the render service's sandbox; this process holds one parsed document and its passages at a time.
MemoryMax=768M
MemorySwapMax=0
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
