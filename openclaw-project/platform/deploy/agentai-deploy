#!/usr/bin/env python3
"""The server end of automatic deploys from GitHub. Installed at /usr/local/sbin/agentai-deploy (root:root 0755); see AUTO_DEPLOY.md.

GitHub's deploy key in /root/.ssh/authorized_keys is pinned to this program (`restrict,command="/usr/local/sbin/agentai-deploy"`), so that key can run nothing else:
no shell, no forwarding, no other command. The SSH command it may send is exactly `deploy <40 hex commit>` or `deploy-dry <40 hex commit>`, followed by one tar stream on stdin:

    manifest.json    {"sha": ..., "ui": true|false, "allow_drift": true|false}
    platform.tgz     the platform tree CI built from that commit (what release.py and the supervisor tree contain, without the virtualenv)
    ui.tgz           the built web app (lumina/dist), when "ui" is true

What it does, in this order, stopping at the first failure:
  0. refuses (exit 30) when a manual release put files on the server that this commit does not contain unchanged, so hand-made fixes are never silently undone.
  1. the app tree through release.py: builds beside the live release, migrates a COPY of the database, probes a canary, probes the previous release against the migrated copy,
     and only then switches. If the live release fails its probes it rolls back itself (exit 2). `deploy-dry` stops after the canary, changing nothing live.
  2. the supervisor tree: a copy of the live one with the new files laid over, `current` switched atomically.
  3. the web app bundle (/var/lib/agentai-platform/ui), the previous one kept as ui.prev.
  4. a restart of the services that run this code, then a check that each is active. If one is not, the supervisor tree goes back to its previous release.
It never touches customer data, secrets or the cells. One deploy at a time (a lock), and a commit that was already deployed is a no-op. Everything is appended to LOG.
"""
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
from pathlib import Path

BASE = Path('/var/lib/agentai-deploy')
LOG = BASE / 'deploys.log'
LAST = BASE / 'last'
LOCK = BASE / 'lock'
APP = Path('/opt/agentai-platform')
SUP = Path('/opt/agentai-supervisor')
UI_PARENT = Path('/var/lib/agentai-platform')
RELEASE_PY = 'deploy/release.py'
UNITS = ['agentai-cell-bridge', 'agentai-browse', 'agentai-tool-relay', 'agentai-request-worker', 'agentai-lifecycle-worker']       # restarted after the trees switch (OPERATIONS.md: full release). The lifecycle worker is a
# stateless loop over the database: an operation it was running is found uncertain and reconciled on its next tick. The supervisor itself (agentai-supervisor-native) is not in this list: it holds the
# control socket the cells' lifecycle depends on, so it is restarted separately and only while no cell operation is in flight (restart_supervisor_when_idle).
SELF = Path('/usr/local/sbin/agentai-deploy')
MAX_BYTES = 400 * 1024 * 1024
COMMAND = re.compile(r'^(deploy|deploy-dry|accept) ([0-9a-f]{40})$')
PREVIOUS = BASE / 'previous.json'          # what the last deploy replaced: where `accept` goes back to when the live acceptance fails
TIERB = BASE / 'tierb.json'                # the last live acceptance result: {sha, passed, at, cases}
OPTIONAL_UNITS = ['agentai-hub-sync', 'agentai-render', 'agentai-knowledge', 'agentai-push']       # long-running services that exist only where their feature was set up: restarted when they are running, so they run the new code (the render service runs the supervisor tree, the knowledge worker and the push gateway the app tree)
# The push gateway (the live stream of the task picture, live/push.py) was only in the rollback's list below, so an ordinary deploy never restarted it: it went on serving the
# task picture of the release it was started on. Found 2026-11-24: 22 hours and eleven releases behind, so the app was shown the old timeline over the stream and the new one
# over its own reads, both at once. The monitor's `releases` check now says so whenever any service runs a release that is not the current one.
APP_UNITS = ['agentai-platform-app']       # the service that runs the app tree and is always there (restarted by a rollback; a deploy restarts it through release.py)
REQUIRED = ('accounts', 'agentai_platform', 'deploy', 'manage.py', 'migrations', 'requirements.lock')



PLATFORM_DB = Path('/var/lib/agentai-platform/platform.sqlite3')


def supervisor_idle(db=PLATFORM_DB) -> bool:
    """No cell is being started, stopped, backed up or restored right now (no lifecycle operation pending, running or uncertain). Read only. Unreadable: not idle."""
    import sqlite3
    try:
        con = sqlite3.connect(f'file:{db}?mode=ro', uri=True, timeout=5)
        try:
            return con.execute("SELECT 1 FROM operations WHERE state IN ('pending','running','uncertain') LIMIT 1").fetchone() is None
        finally:
            con.close()
    except sqlite3.Error:
        return False


def restart_supervisor_when_idle(idle=supervisor_idle, run=None) -> bool:
    """agentai-supervisor-native starts every cell and sets it up: the tool hook, the configuration, the rules. It was never restarted by a deploy, so from 15 November
    to 20 November 2026 every cell was set up by the code of 15 November and no cell-side change of roadmap Phases 2 to 6 reached a cell. It holds the control socket
    the cells' lifecycle depends on, so it is restarted only while no cell operation is in flight (it brings the lifecycle worker back with it, which Requires it);
    otherwise it is left as it is and the log says so. -> whether it was restarted."""
    run = run or sh
    if not idle():
        say('the supervisor was NOT restarted: a cell operation is in flight. Run `systemctl restart agentai-supervisor-native` when it has finished, or the next deploy will')
        return False
    run(['systemctl', 'restart', 'agentai-supervisor-native'])
    return True

def say(message):
    print(message, flush=True)
    try:
        with open(LOG, 'a') as handle:
            handle.write(json.dumps({'at': int(time.time()), 'message': message[:500]}) + '\n')
    except OSError:
        pass


def parse_command(text):
    """-> (mode, sha), or None when the SSH command is anything but the three exact forms (`deploy`, `deploy-dry`, `accept`, each with a 40-hex commit)."""
    match = COMMAND.match(text or '')
    return (match.group(1), match.group(2)) if match else None


def rollback(previous, *, link=None, run=None, base=None, app=None, sup=None, ui_parent=None):
    """Put the system back to what the last deploy replaced: the app tree and the supervisor tree (the symlinks), the web app bundle, then the services. -> a list of what was done.
    The database is never put back (people may have written to it since), so the caller must first ask `cannot_go_back`: a previous release does not start on a database that
    has a migration it does not know. Everything is injectable for tests."""
    link, run = link or switch, run or sh
    base, app, sup, ui_parent = Path(base or BASE), Path(app or APP), Path(sup or SUP), Path(ui_parent or UI_PARENT)
    done = []
    for tree, key in ((app, 'old_app'), (sup, 'old_sup')):
        target = Path(previous.get(key) or '')
        if not target.is_dir() or target.parent.name != 'releases':
            raise ValueError(f'cannot roll back: the previous {tree.name} release is not on this server')
        link(tree / 'current', target)
        done.append(f'{tree.name}/current -> {target.name}')
    ui, prev = ui_parent / 'ui', ui_parent / 'ui.prev'
    if previous.get('ui_replaced') and prev.is_dir():
        failed = ui_parent / 'ui.failed'
        shutil.rmtree(failed, ignore_errors=True)
        if ui.exists():
            os.rename(ui, failed)
        os.rename(prev, ui)
        done.append('web app bundle restored')
    run(['systemctl', 'restart', *UNITS, *APP_UNITS])
    run(['systemctl', 'try-restart', *OPTIONAL_UNITS])      # only those that are running: the previous release's code
    if previous.get('previous_sha'):
        (base / 'last').write_text(previous['previous_sha'] + '\n')
        done.append('last -> ' + previous['previous_sha'][:7])
    return done


def cannot_go_back(previous, *, app=None) -> str:
    """Why the previous release can NOT be put back, or ''. A release starts only on a database whose schema is exactly its own migrations (Store.ready and accounts/wsgi.py
    refuse anything else). So once the release being accepted has applied a migration the previous one does not have, switching the code back leaves the app unable to
    start. On 2026-11-24 that turned one failed acceptance (the test account had no room for the test chat) into an outage: the release was fine, the rollback was not.
    Compared by the migration files each release carries: the SQL ones and the web framework's."""
    old, new = Path(previous.get('old_app') or ''), Path(os.path.realpath(Path(app or APP) / 'current'))
    added = []
    for folder, pattern in (('migrations', '*.sql'), ('accounts/migrations', '0*.py')):
        if (old / folder).is_dir() and (new / folder).is_dir():
            added += sorted({f.name for f in (new / folder).glob(pattern)} - {f.name for f in (old / folder).glob(pattern)})
    if not added:
        return ''
    return f'it applied {len(added)} database migration(s) the previous release does not have ({", ".join(added[:3])}), and the previous release cannot start on that database'


def accept(sha, *, run=None):
    """`accept <commit>`: the live acceptance (deploy/acceptance_live.py) against the system that was just deployed. A failure puts the previous release back (rollback) and exits 40, unless that release could not start on the
    database as it now is (`cannot_go_back`): then the failed release stays live and this exits 43, because a release that failed its acceptance still serves and one that
    cannot start does not.
    When the script says the answer could not be checked for a reason outside the release (its exit 3: no room on the host, the provider busy, the test account's allowance or the
    account itself missing) nothing is rolled back and this exits 42: the run still goes red, so somebody looks, but a good release (or an urgent fix) is not undone by the weather.
    Run by the workflow right after `deploy`, under the same lock; it uploads nothing."""
    run = run or sh
    if not LAST.exists() or LAST.read_text().strip() != sha:
        say(f'refused: {sha[:7]} is not the deployed commit, so there is nothing to accept')
        return 41
    script = Path(os.path.realpath(APP / 'current')) / 'deploy' / 'acceptance_live.py'
    say(f'live acceptance of {sha[:7]}')
    result = run(['systemd-run', '--wait', '--pipe', '--collect', f'--unit=accept-{sha[:7]}', '--property=User=agentai-platform', '--property=EnvironmentFile=/etc/agentai-platform/accounts.env',
                  '--property=WorkingDirectory=/opt/agentai-platform/current', '--property=RuntimeMaxSec=1200', str(Path(os.path.realpath(APP / 'current')) / '.venv' / 'bin' / 'python'), str(script), sha])
    lines = [line for line in (result.stdout or '').splitlines() if line.startswith('{"passed"')]
    try:
        report = json.loads(lines[-1]) if lines else {'passed': False, 'cases': []}
    except ValueError:
        report = {'passed': False, 'cases': []}
    passed = bool(report.get('passed')) and result.returncode == 0
    unchecked = not passed and result.returncode == 3 and report.get('inconclusive') is True
    try:
        TIERB.write_text(json.dumps({'sha': sha, 'passed': passed, 'at': int(time.time()), 'cases': report.get('cases', []),
                                     **({'inconclusive': True, 'why': str(report.get('why', ''))[:200]} if unchecked else {})}))
    except OSError:
        pass
    say((result.stdout or '')[-1200:])
    if passed:
        say(f'live acceptance passed for {sha[:7]}')
        return 0
    if unchecked:
        say(f'live acceptance of {sha[:7]} could NOT BE CHECKED ({str(report.get("why", ""))[:200]}). The release stays. Run the acceptance again when that is cleared.')
        return 42
    try:
        previous = json.loads(PREVIOUS.read_text())
        if previous.get('sha') != sha:
            raise ValueError('the recorded previous release is for another commit')
        stuck = cannot_go_back(previous)
        if stuck:
            say(f'live acceptance FAILED for {sha[:7]} and it was NOT rolled back: {stuck}. The failed release stays live. Fix forward: read the failed cases above and deploy the fix.')
            return 43
        say(f'live acceptance FAILED for {sha[:7]}: putting the previous release back')
        say('rolled back: ' + '; '.join(rollback(previous, run=run)))
    except (OSError, ValueError) as exc:
        say(f'COULD NOT ROLL BACK ({exc}); the failed release is still live: roll back by hand (OPERATIONS.md, release.py)')
    return 40


def forget_manual(live_trees):
    """After a full deploy, drop the record of hand-released files (`source_sha256`) from each live tree.

    The record exists so a deploy never silently undoes a manual release. Once a deploy has replaced those files with a commit's own, the record describes
    nothing that is on the server; kept, it makes every later commit that touches one of those files look like it is undoing a manual release, and every
    deploy is refused until someone overrides the check. A manual release made after this starts a fresh record (push-release.py)."""
    for tree in live_trees:
        path = Path(tree) / 'current' / 'RELEASE.json'
        try:
            meta = json.loads(path.read_text())
            if isinstance(meta, dict) and meta.pop('source_sha256', None) is not None:
                path.write_text(json.dumps(meta, indent=2, sort_keys=True))
        except (OSError, ValueError):
            continue


def safe_extract(archive_bytes, dest):
    """Unpack a tar.gz into `dest`, refusing anything that could land outside it: absolute names, `..`, links, devices."""
    dest = Path(dest).resolve()
    with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode='r:gz') as tar:
        for member in tar.getmembers():
            name = member.name
            target = (dest / name).resolve()
            if name.startswith('/') or '..' in Path(name).parts or not (target == dest or dest in target.parents):
                raise ValueError(f'unsafe path in archive: {name!r}')
            if not (member.isfile() or member.isdir()):
                raise ValueError(f'unsupported entry in archive: {name!r}')
        tar.extractall(dest, filter='data')


def install_self(plat, installed=None):
    """Keep the installed deploy program the same as the one in the commit that was just deployed. -> True when it was replaced.

    The installed copy is what the deploy key is pinned to, and nothing else ever updated it: the server ran the first version for two weeks after fixes to it were merged, and
    one of those fixes (forget_manual) was the reason every deploy was refused. Replaced atomically, after everything else succeeded, so the running deploy finishes on the code
    it started with and a failed deploy never changes the program. The commit's code already runs as root in this deploy (release.py), so this grants it nothing new."""
    installed = Path(installed or SELF)
    incoming = Path(plat) / 'deploy' / 'agentai-deploy'
    try:
        new = incoming.read_bytes()
        if not new.startswith(b'#!') or (installed.exists() and installed.read_bytes() == new):
            return False
        compile(new, str(incoming), 'exec')          # never install a program that does not even parse
        tmp = installed.with_name(installed.name + '.new')
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o755)
        with os.fdopen(fd, 'wb') as handle:
            handle.write(new)
        os.chmod(tmp, 0o755)
        os.replace(tmp, installed)
        return True
    except (OSError, SyntaxError, ValueError):
        return False


def read_stream(stream):
    data = stream.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise ValueError('upload is too large')
    return data


def sh(argv, **kw):
    return subprocess.run(argv, capture_output=True, text=True, **kw)


def drift(live_trees, plat):
    """Files a manual release (push-release.py) put on the server that the incoming code does not contain unchanged. Deploying over them would silently undo that work.
    -> sorted list of 'tree: path' strings. A path the release recorded but the incoming code no longer has counts as a difference too."""
    import hashlib
    found = set()
    for tree in live_trees:
        try:
            recorded = json.loads((Path(tree) / 'current' / 'RELEASE.json').read_text()).get('source_sha256') or {}
        except (OSError, ValueError):
            continue
        for rel, digest in recorded.items():
            if '..' in Path(rel).parts or rel.startswith('/'):
                continue
            incoming = Path(plat) / rel
            if not incoming.is_file() or hashlib.sha256(incoming.read_bytes()).hexdigest() != digest:
                found.add(f'{Path(tree).name}: {rel}')
    return sorted(found)


def switch(link: Path, target: Path):
    tmp = link.with_name(link.name + '.new')
    tmp.unlink(missing_ok=True)
    os.symlink(target, tmp)
    os.replace(tmp, link)


def main(argv=None, stdin=None):
    parsed = parse_command(os.environ.get('SSH_ORIGINAL_COMMAND', ''))
    if parsed is None:
        print('refused: the only commands are "deploy <commit>", "deploy-dry <commit>" and "accept <commit>"', file=sys.stderr)
        return 2
    mode, sha = parsed
    BASE.mkdir(mode=0o700, parents=True, exist_ok=True)
    import fcntl
    lock = open(LOCK, 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        say('refused: another deploy is running')
        return 3
    if mode == 'accept':
        return accept(sha)
    if mode == 'deploy' and LAST.exists() and LAST.read_text().strip() == sha:
        say(f'{sha[:7]} is already the deployed commit; nothing to do')
        return 0
    work = BASE / f'incoming-{sha[:12]}'
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(mode=0o700)
    try:
        outer = (stdin or sys.stdin.buffer)
        safe_extract(read_stream(outer), work)
        manifest = json.loads((work / 'manifest.json').read_text())
        if manifest.get('sha') != sha:
            raise ValueError('the upload is for a different commit than the one named')
        plat = work / 'platform'
        plat.mkdir()
        safe_extract((work / 'platform.tgz').read_bytes(), plat)
        for needed in REQUIRED:
            if not (plat / needed).exists():
                raise ValueError(f'the platform archive has no {needed}')
        name = f'{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())}-{sha[:7]}'
        say(f'{mode} {sha[:7]} as {name}')

        # 0. do not silently undo a manual release: files put on the server by push-release.py must be in the incoming code unchanged (commit them to main first).
        differing = drift([APP, SUP], plat)
        if differing and not manifest.get('allow_drift'):
            say(f'refused: the server runs {len(differing)} file(s) that were released by hand and are not in this commit (commit and merge them to main first, or run the workflow by hand with "overwrite manual changes"):\n  ' + '\n  '.join(differing[:40]))
            return 30
        if differing:
            say(f'WARNING: overwriting {len(differing)} manually released file(s), as asked: ' + ', '.join(differing[:40]))

        # 1. the app tree: canary, migration of a copy, probes, automatic rollback (release.py).
        release_tgz = work / 'release.tgz'
        with tarfile.open(release_tgz, 'w:gz') as tar:
            for entry in sorted(plat.iterdir()):
                tar.add(entry, arcname=entry.name)
        old_app = os.path.realpath(APP / 'current')
        old_sup = os.path.realpath(SUP / 'current')
        run = sh([sys.executable, str(plat / RELEASE_PY), '--tarball', str(release_tgz), '--id', name] + (['--dry-run'] if mode == 'deploy-dry' else []))
        say((run.stdout + run.stderr)[-1500:])
        if run.returncode != 0:
            say(f'app release failed or rolled back (exit {run.returncode}); nothing else was changed')
            return 10 + run.returncode
        if mode == 'deploy-dry':
            say('dry run passed: the canary release is healthy and nothing live was changed')
            return 0

        # 2. the supervisor tree: copy of the live one, new files over it, atomic switch.
        new_sup = SUP / 'releases' / name
        shutil.rmtree(new_sup, ignore_errors=True)
        sh(['cp', '-a', old_sup, str(new_sup)], check=True)
        for entry in ('accounts', 'agentai_platform', 'deploy', 'migrations'):
            shutil.rmtree(new_sup / entry, ignore_errors=True)
            shutil.copytree(plat / entry, new_sup / entry)
        sh(['chown', '-R', 'root:root', str(new_sup / 'agentai_platform'), str(new_sup / 'accounts'), str(new_sup / 'deploy'), str(new_sup / 'migrations')], check=True)
        sh(['chmod', '-R', 'go-w,a+rX', str(new_sup)], check=True)
        meta_path = new_sup / 'RELEASE.json'
        meta = json.loads(meta_path.read_text()) if meta_path.exists() else {}
        meta.update(commit=sha, release=name, purpose='automatic deploy from GitHub')
        meta_path.write_text(json.dumps(meta, indent=2, sort_keys=True))
        switch(SUP / 'current', new_sup)

        # 3. the web app bundle.
        if manifest.get('ui') and (work / 'ui.tgz').exists():
            ui_new, ui, ui_prev = UI_PARENT / 'ui.new', UI_PARENT / 'ui', UI_PARENT / 'ui.prev'
            shutil.rmtree(ui_new, ignore_errors=True)
            ui_new.mkdir(mode=0o755)
            safe_extract((work / 'ui.tgz').read_bytes(), ui_new)
            if not (ui_new / 'index.html').is_file():
                raise ValueError('the web app bundle has no index.html')
            sh(['chown', '-R', 'root:agentai-platform', str(ui_new)], check=True)
            sh(['chmod', '-R', 'go-w,a+rX', str(ui_new)], check=True)
            shutil.rmtree(ui_prev, ignore_errors=True)
            if ui.exists():
                os.rename(ui, ui_prev)
            os.rename(ui_new, ui)
            scenes = ui / 'scenes'
            if scenes.is_dir():                                  # Caddy serves the chat film from its own public folder (see deploy-lumina.py)
                public = Path('/var/www/lumina-scenes/app')
                public.mkdir(parents=True, exist_ok=True)
                shutil.rmtree(public / 'scenes.new', ignore_errors=True)
                shutil.copytree(scenes, public / 'scenes.new')
                shutil.rmtree(public / 'scenes.old', ignore_errors=True)
                if (public / 'scenes').exists():
                    os.rename(public / 'scenes', public / 'scenes.old')
                os.rename(public / 'scenes.new', public / 'scenes')

        # 4. restart what runs this code, and check it came back.
        restart_supervisor_when_idle()                         # the cells' setup code (hook, configuration, rules) runs in the supervisor: it must run this release too
        sh(['systemctl', 'restart', *UNITS])
        sh(['systemctl', 'try-restart', *OPTIONAL_UNITS])      # only those that are running; one that is not installed is left alone and never fails a deploy
        time.sleep(3)
        down = [u for u in UNITS if sh(['systemctl', 'is-active', u]).stdout.strip() != 'active']
        if down:
            say(f'these did not come back: {", ".join(down)}; putting the supervisor tree back')
            switch(SUP / 'current', Path(old_sup))
            sh(['systemctl', 'restart', *UNITS])
            return 20
        forget_manual([APP, SUP])                # both trees now hold exactly this commit: nothing on the server is a hand-made release any more
        try:
            previous_sha = LAST.read_text().strip() if LAST.exists() else ''
            PREVIOUS.write_text(json.dumps({'sha': sha, 'previous_sha': previous_sha, 'old_app': old_app, 'old_sup': old_sup, 'ui_replaced': bool(manifest.get('ui')), 'at': int(time.time())}))
        except OSError:
            pass
        LAST.write_text(sha + '\n')
        if install_self(plat):
            say('the deploy program itself changed in this commit: the installed copy was replaced and the next deploy uses it')
        say(f'deployed {sha[:7]} as {name}. Undo the supervisor tree: ln -sfn {old_sup} {SUP}/current && systemctl restart {" ".join(UNITS)}; the app tree: see OPERATIONS.md (release.py)')
        return 0
    except Exception as exc:
        say(f'failed: {type(exc).__name__}: {exc}')
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == '__main__':
    sys.exit(main())
