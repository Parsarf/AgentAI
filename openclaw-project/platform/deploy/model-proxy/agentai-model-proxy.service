[Unit]
Description=AgentAI model-proxy relay for customer cells (10.77.0.1:4000 -> LiteLLM loopback)
After=agentai-cells-docker.service docker.service
Requires=agentai-cells-docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/agentai-ops/model-proxy/agentai_model_proxy.py
DynamicUser=yes
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
MemoryMax=96M
TasksMax=64

[Install]
WantedBy=multi-user.target
