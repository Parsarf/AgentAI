# Customer HTTPS edge only. Owner Gateway and internal operator API stay private.
backend.getlumina.pro {
    # Live view frames: exactly one path shape, to the frame gateway inside the browse service (never the web app's single worker).
    # It must come before the general /v1 rule below, and it rides the /v1 route Vercel already forwards.
    @liveframe path_regexp liveframe ^/v1/live/[a-f0-9]{32}/frame$
    handle @liveframe {
        reverse_proxy 127.0.0.1:18801 {
            flush_interval -1
            header_up -Forwarded
        }
    }
    # The customer's own Chrome (the Lumina extension): one WebSocket path, to the device gateway inside the browse service. Caddy proxies the upgrade by itself.
    # The extension connects here directly, not through Vercel. The gateway checks the Origin and the device token; nothing else is reachable on this port.
    @device path /v1/device
    handle @device {
        reverse_proxy 127.0.0.1:18802 {
            header_up -Forwarded
        }
    }
    # Chat background videos: Caddy serves them from their own public folder, /var/www/lumina-scenes (byte ranges for Safari, no load on the web app's single worker). The state directory holding the database stays private, so Caddy cannot read the UI bundle; bin/deploy-lumina.py refreshes this folder on every frontend deploy.
    @scenes path_regexp scenes ^/app/scenes/[a-z_-]+\.(mp4|jpg)$
    handle @scenes {
        root * /var/www/lumina-scenes
        header Cache-Control "public, max-age=86400"
        file_server
    }
    @customer path /account /account/* /auth /auth/* /v1 /v1/* /app /app/*
    handle @customer {
        reverse_proxy 127.0.0.1:18800 {
            header_up Host getlumina.pro
            header_up X-Forwarded-Proto https
            header_up X-AgentAI-Client-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up -Forwarded
        }
    }
    handle {
        respond "Not found" 404
    }
}
