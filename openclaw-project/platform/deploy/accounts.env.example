# Install as /etc/agentai-platform/accounts.env, owner root:agentai-platform 0640.
# Generate a unique random secret privately. Never commit a filled version.
AGENTAI_SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
AGENTAI_STATE_DIR=/var/lib/agentai-platform
AGENTAI_PUBLIC_ORIGIN=https://agent.example.com
AGENTAI_MAIL_ENABLED=0
# SMTP delivery remains off until a mail provider/domain and message authorization exist.
# AGENTAI_SMTP_HOST=
# AGENTAI_SMTP_USER=
# AGENTAI_SMTP_PASSWORD=
# AGENTAI_FROM_EMAIL=
