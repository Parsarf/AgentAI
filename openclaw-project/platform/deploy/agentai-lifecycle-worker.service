[Unit]
Description=AgentAI lifecycle worker (queue to supervisor; no root, no Docker)
After=agentai-supervisor-native.service
Requires=agentai-supervisor-native.service

[Service]
User=agentai-platform
Group=agentai-platform
WorkingDirectory=/opt/agentai-supervisor/current
Environment=AGENTAI_SWITCHES_FILE=/opt/openclaw-production/feature-switches/switches.json
Environment=AGENTAI_SWITCH_FACTS_FILE=/opt/openclaw-production/feature-switches/facts.json
ExecStart=/usr/bin/python3 -m agentai_platform.lifecycle.worker_main
UMask=0077
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/agentai-platform
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=16
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
