[Unit]
Description=Lumina mail and calendar dashboard: keep connected accounts in sync, live
After=network-online.target agentai-platform-app.service

[Service]
Type=simple
User=agentai-platform
Group=agentai-platform
WorkingDirectory=/opt/agentai-platform/current
EnvironmentFile=/etc/agentai-platform/accounts.env
# Eight header reads run at once during a first fill; glibc gives each thread its own memory arena and keeps it. Two arenas stop that growth.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/agentai-platform/current/.venv/bin/python manage.py hub_sync --serve
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/agentai-platform
ReadOnlyPaths=/etc/agentai-platform
# A first fill of a large mailbox passed 384 MB and was killed in a loop (production, 2026-11-16); steady state is about 75 MB.
MemoryMax=1G
MemorySwapMax=0
CPUQuota=50%
TasksMax=48

[Install]
WantedBy=multi-user.target
