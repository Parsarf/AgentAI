table inet agentai_cells {
  set cell_sources { type ipv4_addr; flags interval; elements = { 10.77.0.0/16, 10.78.0.0/16 } }
  set private_ranges { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } }
  chain input {
    type filter hook input priority -5; policy accept;
    ip saddr != @cell_sources return
    ct state established,related return
    counter drop comment "cell to host services"
  }
  chain forward {
    type filter hook forward priority -5; policy accept;
    ip saddr != @cell_sources return
    ip daddr @private_ranges counter drop comment "cell to private/metadata"
  }
}
