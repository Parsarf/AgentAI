[Unit]
Description=AgentAI host lifecycle supervisor (native Fleet backend on the cell engine)
After=network.target agentai-cells-docker.service agentai-cells-firewall.service
Requires=agentai-cells-docker.service

[Service]
User=root
Group=agentai-platform
WorkingDirectory=/opt/agentai-supervisor/current
ExecStart=/usr/bin/python3 -m agentai_platform.lifecycle.supervisor_main \
    --controller-user agentai-platform \
    --native-wiring /etc/agentai-supervisor/native-wiring.json
UMask=0077
RuntimeDirectory=agentai-supervisor
RuntimeDirectoryMode=0750
StateDirectory=agentai-supervisor
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
# Loop mounts, nft reloads and docker calls must happen in the host namespaces, so
# no mount-namespace sandboxing (ProtectSystem/PrivateTmp/PrivateDevices) here.
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=no
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETGID CAP_SETUID CAP_MKNOD
MemoryMax=768M
MemorySwapMax=0
CPUQuota=100%
TasksMax=256
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
