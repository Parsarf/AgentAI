[Unit]
Description=AgentAI long-term memory sweep (retry unconfirmed deletions, clean half-finished saves)
After=network-online.target agentai-platform-app.service

[Service]
Type=oneshot
User=agentai-platform
Group=agentai-platform
WorkingDirectory=/opt/agentai-platform/current
EnvironmentFile=/etc/agentai-platform/accounts.env
ExecStart=/opt/agentai-platform/current/.venv/bin/python manage.py memory_sweep
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/agentai-platform
ReadOnlyPaths=/etc/agentai-platform
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=16
TimeoutStartSec=120
