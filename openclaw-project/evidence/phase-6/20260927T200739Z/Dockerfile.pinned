FROM python@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
RUN pip install --no-cache-dir 'workspace-mcp==1.29.0' 'mcp>=1.28.1' 'pyasn1>=0.6.4' \
    && pip freeze > /opt/connector-requirements.txt
RUN useradd --uid 1000 --create-home connector
ENV HOME=/home/connector \
    PYTHONDONTWRITEBYTECODE=1 \
    WORKSPACE_MCP_CREDENTIALS_DIR=/data/credentials \
    GOOGLE_CLIENT_SECRET_PATH=/data/client-secret.json \
    WORKSPACE_MCP_LOG_LEVEL=WARNING \
    WORKSPACE_MCP_PORT=8000
USER 1000:1000
WORKDIR /tmp
ENTRYPOINT ["workspace-mcp"]
CMD ["--transport", "stdio", "--tools", "gmail", "calendar", "drive", "--read-only"]
