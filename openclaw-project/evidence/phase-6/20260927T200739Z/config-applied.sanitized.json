[
  {
    "path": "mcp.servers.google-readonly",
    "value": {
      "enabled": false,
      "transport": "stdio",
      "command": "/usr/bin/docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--read-only",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "--pids-limit=128",
        "--memory=384m",
        "--cpus=0.5",
        "--user=1000:1000",
        "--tmpfs",
        "/tmp:rw,nosuid,nodev,size=64m",
        "--mount",
        "type=bind,src=/opt/openclaw-production/integrations/google/private,dst=/data",
        "--env",
        "USER_GOOGLE_EMAIL=<owner-google-account>",
        "--env",
        "WORKSPACE_MCP_LOG_DIR=/tmp/logs",
        "--env",
        "WORKSPACE_MCP_MAX_FILE_BYTES=5242880",
        "--env",
        "WORKSPACE_MCP_DISABLE_LOCAL_FILES=true",
        "sha256:17620499dba778fa67572e0ac5f93ae59c570734901b5671ddfbb1197fc0fc4c"
      ],
      "connectionTimeoutMs": 30000,
      "requestTimeoutMs": 20000,
      "toolFilter": {
        "include": [
          "search_gmail_messages",
          "get_gmail_message_content",
          "get_gmail_messages_content_batch",
          "list_calendars",
          "get_events",
          "search_drive_files",
          "get_drive_file_content",
          "list_drive_items"
        ]
      },
      "codex": {
        "agents": [
          "researcher"
        ]
      }
    }
  },
  {
    "path": "mcp.servers.github-readonly",
    "value": {
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "transport": "streamable-http",
      "enabled": false,
      "connectionTimeoutMs": 10000,
      "requestTimeoutMs": 20000,
      "toolFilter": {
        "include": [
          "get_me",
          "get_file_contents",
          "list_commits",
          "get_commit",
          "list_branches",
          "list_issues",
          "issue_read",
          "list_pull_requests",
          "pull_request_read"
        ]
      },
      "codex": {
        "agents": [
          "researcher"
        ]
      }
    }
  },
  {
    "path": "tools.alsoAllow",
    "value": [
      "session_status",
      "read",
      "ls",
      "write",
      "edit",
      "apply_patch",
      "exec",
      "process",
      "web_fetch",
