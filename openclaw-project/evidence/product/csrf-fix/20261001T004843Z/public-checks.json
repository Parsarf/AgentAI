{
  "referrer_policy": "same-origin",
  "cache_control": "no-store",
  "origin": {
    "status": 404,
    "retry_form": false,
    "content_type": "application/json"
  },
  "referer_only": {
    "status": 404,
    "retry_form": false,
    "content_type": "application/json"
  },
  "cross_origin": {
    "status": 403,
    "retry_form": true,
    "content_type": "text/html; charset=utf-8"
  },
  "no_origin_no_referer": {
    "status": 403,
    "retry_form": true,
    "content_type": "text/html; charset=utf-8"
  }
}
