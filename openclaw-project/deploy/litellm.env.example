# Copy to deploy/secrets/litellm.env (mode 0600) on the server.
# Use a NEW dedicated database, not AgentAI's DATABASE_URL.
# URL-encode the database password in DATABASE_URL.
DATABASE_URL=
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=
# Generate once for a new proxy; preserve it during every recreation/upgrade.
LITELLM_SALT_KEY=
