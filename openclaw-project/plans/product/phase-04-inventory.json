  "fleet_help": {
    "create": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet create [options] <tenant>\n\nCreate an isolated tenant cell\n\nArguments:\n  tenant                   Tenant slug\n\nOptions:\n  --cpus <count>           Container CPU limit (default: \"2\")\n  --disk <size>            Cap the container writable layer (requires\n                           overlay2+XFS pquota, btrfs, or zfs)\n  --env <KEY=VAL>          Pass an environment variable to the cell (default:\n                           [])\n  --gateway-token <token>  Use an existing Gateway token\n  -h, --help               Display help for command\n  --image <ref>            Container image (default:\n                           \"ghcr.io/openclaw/openclaw:latest\")\n  --json                   Output JSON (default: false)\n  --memory <limit>         Container memory limit (default: \"2g\")\n  --network <mode>         Container egress network (bridge or internal)\n                           (default: \"bridge\")\n  --no-start               Create the container without starting it\n  --pids-limit <count>     Container process limit (default: 512)\n  --port <port>            Host loopback port (default: allocate from 19100)\n  --runtime <runtime>      Container runtime (docker or podman) (default:\n                           \"docker\")\n"
    },
    "start": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet start [options] <tenant>\n\nStart a tenant cell\n\nArguments:\n  tenant      Tenant slug\n\nOptions:\n  -h, --help  Display help for command\n"
    },
    "stop": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet stop [options] <tenant>\n\nStop a tenant cell\n\nArguments:\n  tenant      Tenant slug\n\nOptions:\n  -h, --help  Display help for command\n"
    },
    "upgrade": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet upgrade [options] <tenant>\n\nReplace a tenant cell with a freshly pulled image\n\nArguments:\n  tenant         Tenant slug\n\nOptions:\n  -h, --help     Display help for command\n  --image <ref>  Replacement image (default: recorded image)\n"
    },
    "backup": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet backup [options] <tenant>\n\nBack up one tenant cell as a host operator (archive contains secrets)\n\nArguments:\n  tenant               Tenant slug\n\nOptions:\n  -h, --help           Display help for command\n  --json               Output JSON (default: false)\n  --max-bytes <bytes>  Maximum archive input bytes\n  --out <path>         Archive output path or directory\n"
    },
    "restore": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet restore [options] <tenant>\n\nRestore one tenant cell as a host operator (archive contains secrets)\n\nArguments:\n  tenant               Tenant slug\n\nOptions:\n  --force              Stop a running cell and replace its state (default:\n                       false)\n  --from <path>        Fleet backup archive\n  -h, --help           Display help for command\n  --json               Output JSON (default: false)\n  --max-bytes <bytes>  Maximum extracted bytes\n"
    },
    "rm": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet rm [options] <tenant>\n\nRemove a tenant cell\n\nArguments:\n  tenant        Tenant slug\n\nOptions:\n  --force       Remove a running cell (default: false)\n  -h, --help    Display help for command\n  --purge-data  Delete the tenant data directory (default: false)\n"
    },
    "doctor": {
      "exit": 0,
      "output": "\nOpenClaw 2026.9.6 (eb377ac) \u2014 All your chats, one OpenClaw.\n\nUsage: openclaw fleet doctor [options] [tenant]\n\nAudit fleet cells without changing them\n\nArguments:\n  tenant      Tenant slug\n\nOptions:\n  -h, --help  Display help for command\n  --json      Output JSON (default: false)\n"
    },
    "status": {
      "exit": 0,
