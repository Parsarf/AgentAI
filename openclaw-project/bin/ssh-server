#!/usr/bin/env python3
"""Run one command on the production server using .env SSH credentials.

Never prints credentials; command output only. Uses strict host-key checking
and a single password prompt answered from the private env file.
"""
import os
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

from dotenv import dotenv_values

repo = Path(__file__).resolve().parents[2]
env_file = repo / "agent/.env"
if stat.S_IMODE(env_file.stat().st_mode) & 0o077:
    raise SystemExit("agent/.env must be private (mode 0600)")
values = dotenv_values(env_file)
user = values.get("OPENCLAW_SSH_USER", "")
if not user or not values.get("OPENCLAW_SSH_PASSWORD"):
    raise SystemExit("Set OPENCLAW_SSH_USER and OPENCLAW_SSH_PASSWORD in agent/.env")
target = user + "@69.48.206.62"

if len(sys.argv) < 2:
    raise SystemExit("Usage: ssh-server <remote command...>")

with tempfile.TemporaryDirectory(prefix="openclaw-ssh-") as directory:
    askpass = Path(directory) / "askpass"
    askpass.write_text(
        "#!" + sys.executable + "\n"
        "from dotenv import dotenv_values\n"
        "print(dotenv_values(" + repr(str(env_file)) + ")[\"OPENCLAW_SSH_PASSWORD\"])\n"
    )
    askpass.chmod(0o700)
    env = os.environ.copy()
    env.update(SSH_ASKPASS=str(askpass), SSH_ASKPASS_REQUIRE="force", DISPLAY="openclaw:0")
    result = subprocess.run(
        ["ssh", "-o", "StrictHostKeyChecking=yes", "-o", "ConnectTimeout=15",
         "-o", "NumberOfPasswordPrompts=1", "-o", "PreferredAuthentications=password",
         "-o", "PubkeyAuthentication=no", "-T", target, "--"] + sys.argv[1:],
        env=env, stdin=subprocess.DEVNULL,
    )
    raise SystemExit(result.returncode)
