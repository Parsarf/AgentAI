#!/usr/bin/env python3
"""Convenient operator wrapper for the VPS's native MCP connector manager."""
from pathlib import Path
import shlex
import subprocess
import sys

root = Path(__file__).resolve().parents[2]
if not sys.argv[1:] or any(arg in ("-h", "--help") for arg in sys.argv[1:]):
    raise SystemExit(subprocess.run([sys.executable, str(root / "openclaw-project/bin/phase6/manage-connectors.py"), *(sys.argv[1:] or ["--help"])]).returncode)
command = shlex.join(["python3", "/opt/openclaw-production/integrations/manage-connectors.py", *sys.argv[1:]])
raise SystemExit(subprocess.run([str(root / ".venv/bin/python"), str(root / "openclaw-project/bin/ssh-server"), command]).returncode)
