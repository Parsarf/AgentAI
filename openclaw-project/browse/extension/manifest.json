{
  "manifest_version": 3,
  "name": "Lumina Browser",
  "version": "0.3.0",
  "description": "Chat with Lumina beside any tab. It browses for you in a new tab, or in a tab you allow, only while you switch it on.",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabGroups",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Lumina",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://getlumina.pro/*"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open or close the Lumina chat"
    }
  }
}
