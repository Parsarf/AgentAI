# ---------------------------------------------------------------------------
# Operator-level configuration. Copy to .env and fill in.
# Each entry names the Part 0a setup item in agent-build-spec-multiuser.md
# that provides it. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Item #1 — Anthropic API key. One shared key powers every user's agent;
# set a hard spend limit in the Anthropic console as a backstop.
ANTHROPIC_API_KEY=

# Item #7 — Web search API key (Brave Search API, SerpAPI, or Google
# Programmable Search). Shared infra, metered per user.
SEARCH_API_KEY=

# Item #2 — Telegram bot token (message @BotFather, run /newbot).
TELEGRAM_BOT_TOKEN=

# Postgres 16 DSN with the pgvector extension available (Phase 1).
# Dev container option:
#   docker run -d --name agentai-pg -p 5433:5432 \
#     -e POSTGRES_USER=agent -e POSTGRES_PASSWORD=agent -e POSTGRES_DB=agent \
#     pgvector/pgvector:pg16
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent

# Item #5 — Transactional email provider API key (Resend or Postmark).
# Used for signup verification and password reset. Which provider is
# selected in config/settings.yaml (email.provider).
EMAIL_API_KEY=

# Item #9 — Stripe (needed from Phase 5; leave empty until then).
# Use TEST MODE keys (sk_test_...) until you deliberately go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Item #8 — Vault master key (needed from Phase 4). Envelope-encrypts the
# per-user vault data keys. Generate with:  openssl rand -base64 32
VAULT_MASTER_KEY=

# Session signing secret (needed from Phase 1). Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Public base URL of the web app — used to build links in emails.
BASE_URL=http://localhost:8000
